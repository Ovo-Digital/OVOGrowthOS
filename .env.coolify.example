# Bu dosya yalnızca alan adlarını gösterir. Gerçek değerleri Coolify paneline girin.
IMAGE_REGISTRY=ghcr.io/ovo-digital
IMAGE_TAG=latest
SUPABASE_DATABASE_CONNECTION_STRING=Host=your-pooler.supabase.com;Port=5432;Database=postgres;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=true
DEFAULT_ADMIN_EMAIL=admin@ovodigital.com
DEFAULT_ADMIN_PASSWORD_HASH=base64-salt.base64-password-hash
SERVICE_BASE64_64_JWT=replace-with-a-random-value-at-least-32-characters
WEB_ORIGIN=https://ovogrowth.ovodigi.com
JWT_ISSUER=ovo-growth-os
JWT_AUDIENCE=ovo-growth-os-web
